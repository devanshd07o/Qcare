# QCare Backend Environment Variables
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — uncomment and set):
# DATABASE_URL="postgresql://user:password@localhost:5432/qcare_db?schema=public"

# ── Auth (JWT) ────────────────────────────────────────────
# Generate strong secrets: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL (CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173
